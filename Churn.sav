      "cell_type": "markdown",
      "metadata": {
        "id": "77f26ff8"
      },
      "source": [
        "### Analyze Categorical Features\n",
        "\n",
        "Next, we will analyze the categorical features, examining their unique values, counts, and their relationship with the 'Churn' variable."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 849
        },
        "id": "4e1b9897",
        "outputId": "cce8f491-32f8-46ba-b529-6b3b24b371ce"
      },
      "source": [
        "categorical_cols = df.select_dtypes(include='object').columns.tolist()\n",
        "# Based on df.info() and df.describe(), 'Age Group', 'Tariff Plan', and 'Status' are int64 but represent categories.\n",
        "categorical_cols.extend(['Age Group', 'Tariff Plan', 'Status', 'Complains'])\n",
        "\n",
        "print('\\nUnique values and counts for categorical features:')\n",
        "for col in categorical_cols:\n",
        "    print(f'\\n--- {col} --')\n",
        "    print(df[col].value_counts())\n",
        "\n",
        "\n",
        "# Plotting categorical features against Churn\n",
        "plt.figure(figsize=(20, 15))\n",
        "for i, col in enumerate(categorical_cols, 1):\n",
        "    plt.subplot(3, 3, i) # Adjust subplot grid as needed\n",
        "    sns.countplot(x=col, hue='Churn', data=df)\n",
        "    plt.title(f'Distribution of {col} by Churn')\n",
        "    plt.xlabel(col)\n",
        "    plt.ylabel('Count')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
